# FootMANAGER Mobile — Environment Template
# Copy this file to .env and set real values for your machine.
# .env is gitignored — never commit real URLs or secrets.
#
# WARNING: Every EXPO_PUBLIC_* variable is bundled into the JavaScript
# bundle and visible to anyone who inspects the app. Do NOT put private
# keys, passwords, signing secrets, or database credentials here.

# ── API ──────────────────────────────────────────────────────────────
# Single source of truth for the Laravel API base URL.
# Used via `config.apiUrl` (src/config/env.ts) — never hardcode in code.
#
# Development: use your machine's LAN IP so physical devices on the same
# Wi-Fi can reach the backend. `localhost` only works for simulators.
#   EXPO_PUBLIC_API_URL=http://192.168.1.6/api
#   EXPO_PUBLIC_API_URL=http://10.0.0.5:8000/api
#
# Preview (staging): set in EAS Build secret or CI
#   EXPO_PUBLIC_API_URL=https://staging.api.footmanager.com/api
#
# Production: set in EAS Build secret or CI
#   EXPO_PUBLIC_API_URL=https://api.footmanager.com/api
#
# Replace with your machine's LAN IP (run ipconfig / ifconfig to find it)
EXPO_PUBLIC_API_URL=

# ── Environment ──────────────────────────────────────────────────────
# Distinguishes behavior without changing source code.
# Must be one of: development | preview | production
# - development: local dev (Expo Go, `npx expo start`)
# - preview:     internal staging build (EAS `preview` profile)
# - production:  store build (EAS `production` profile)
#
# Switch by changing this value only — no code changes needed.
# EAS Build injects the correct value per profile via `env` in eas.json
# or via dashboard secrets.
EXPO_PUBLIC_APP_ENV=development

# ── Support ───────────────────────────────────────────────────────────
# Contact destination shown by the "Contact support" link in the app
# (e.g. registration result screen). Use a mailto: address so the user's
# device opens their mail app, or a public support page URL.
# Leave empty to hide the support link at runtime.
#   EXPO_PUBLIC_SUPPORT_CONTACT=mailto:support@footmanager.app
EXPO_PUBLIC_SUPPORT_CONTACT=
