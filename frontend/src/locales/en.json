        "id": "general",
        "title": "General",
        "items": [
          {
            "q": "Is AJIN9SSRO free for team managers?",
            "a": "Yes, account registration and creating match requests are completely free for team managers."
          },
          {
            "q": "How do I join a category?",
            "a": "During registration you choose your team's category (Adults, Teenagers, Children) and your team appears in that category's leaderboard."
          }
        ]
      },
      {
        "id": "managers",
        "title": "Team Managers",
        "items": [
          {
            "q": "How does score confirmation work?",
            "a": "After the match, one manager submits the score and the opposing team receives a notification to confirm it."
          },
          {
            "q": "What happens if an opponent disputes a score?",
            "a": "The score is marked as disputed and can be resubmitted, with possible administration intervention to settle the matter."
          }
        ]
      },
      {
        "id": "owners",
        "title": "Terrain Owners",
        "items": [
          {
            "q": "How do I register my pitch?",
            "a": "Create a terrain owner account, wait for admin approval, then add your pitch with photos, pricing, and working hours."
          },
          {
            "q": "How do slot closures work?",
            "a": "You set working hours per day and can close specific slots for maintenance or private events — bookings won't be accepted in those slots."
          }
        ]
      },
      {
        "id": "bookings",
        "title": "Bookings",
        "items": [
          {
            "q": "Can I cancel a reservation?",
            "a": "Yes, you can cancel a reservation before the scheduled time by contacting the terrain owner."
          },
          {
            "q": "How do WhatsApp notifications work?",
            "a": "When a booking is submitted, accepted, or confirmed, a WhatsApp notification is sent directly to the relevant party."
          }
        ]
      }
    ]
