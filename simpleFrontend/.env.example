# Simple frontend environment variables - EXAMPLE template
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file. `.env` is git-ignored.

# Base URL of the Laravel API backend (no trailing slash)
# Local dev default: http://localhost:8000/api
# Production example: https://api.your-domain.com/api
VITE_API_URL=http://localhost:8000/api
