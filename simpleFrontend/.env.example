# Simple frontend environment variables - EXAMPLE template
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file. `.env` is git-ignored.
#
# All VITE_ prefixed variables are embedded into the client bundle
# at build time and are PUBLIC. Do not put secrets here.

# Base URL of the Laravel API backend (no trailing slash)
# Local dev:   http://localhost:8000/api
# Production:  https://api.your-domain.com/api
VITE_API_URL=http://localhost:8000/api

# Reverb (WebSockets) - used by the in-app realtime notifications.
# Set PUBLIC values only; secrets stay on the backend.
# Local dev:
VITE_REVERB_HOST=localhost
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=footmanager-key
# Production (fill in your Railway Reverb public domain / scheme / app key):
# VITE_REVERB_HOST=your-reverb-upstream.railway.app
# VITE_REVERB_SCHEME=https
# VITE_REVERB_APP_KEY=your-reverb-app-key

# Web Push VAPID public key (used by the service worker for push subscriptions).
# Local dev:
VITE_VAPID_PUBLIC_KEY=BFsCR1p_7cBsFBKZjt6TlF6GzoEf0eWdxUZgYFC5mpQqetHAVg6Yh3zKtpkxQ4J45cA_akrBMJKNL4zHQiDkCvY
# Production (copy from backend .env, only the public key — keep VAPID_PRIVATE_KEY server-side only).
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
